<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep this lab's packages out of the global cache, so the lab can be deleted cleanly -->
    <add key="globalPackagesFolder" value="../../.nuget-cache" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="lab-feed" value="../../feed" />
  </packageSources>
</configuration>
